# Copy to .env and fill in your key
# Only ONE provider key is needed

# === RECOMMENDED: Groq (14,400 req/day free, fastest) ===
# Register: https://console.groq.com (email only, no credit card)
GROQ_API_KEY=gsk_xxx
CROQTILE_PROVIDER=groq
CROQTILE_MODEL=llama-3.1-8b-instant
# Alt: llama-3.3-70b-versatile (better quality, 1000 req/day)

# === OpenRouter (200 req/day, 28+ free models) ===
# Register: https://openrouter.ai → Settings → Keys
# OPENROUTER_API_KEY=sk-or-v1-xxx
# CROQTILE_PROVIDER=openrouter
# CROQTILE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# === Google Gemini (1,500 req/day) ===
# Register: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...
# CROQTILE_PROVIDER=google
# CROQTILE_MODEL=gemini-2.5-flash

# === Anthropic (paid) ===
# ANTHROPIC_API_KEY=sk-ant-xxx
# CROQTILE_PROVIDER=anthropic
# CROQTILE_MODEL=claude-sonnet-4-20250514

# Workspace directory (where agent writes files)
# CROQTILE_WORKSPACE=/tmp/croqtile-tuner/workspace
